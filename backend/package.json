{
  "name": "financy-backend",
  "version": "1.0.0",
  "description": "Financy - API GraphQL de gestão financeira",
  "scripts": {
    "test": "rm -f prisma/test.db && export DATABASE_URL=file:./test.db PORT=4001 JWT_SECRET=test && prisma migrate deploy && node --import tsx --test --test-force-exit tests/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
